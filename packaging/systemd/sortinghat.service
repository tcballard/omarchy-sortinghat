[Unit]
Description=SortingHat review-first file organisation service
Documentation=https://github.com/tcballard/Omarchy-SortingHat

[Service]
Type=simple
ExecStart=%h/.local/bin/sortinghatd --socket %t/sortinghat.sock --state-dir %h/.local/state/sortinghat
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
